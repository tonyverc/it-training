{% extends 'base.html.twig' %}

{% block title %}Hello Exclure formateur !
{% endblock %}

{% block body %}
	<div class="flex flex-col items-center p-2 ">
		<h2 class="w-[100%] text-2xl font-bold text-blue-950">Formateur</h2>
		<div class='max-w-[850px] w-[100%]'>
			{% for formateur in formateurs %}
				<div class="flex flex-row odd:bg-white even:bg-[#E8E8E8] p-2 w-[100%]">
					<div class="flex-grow w-1/3">
						<span class="font-bold uppercase">{{formateur.nom}}</span>
						{{formateur.prenom}}</div>
					<div class="flex-grow text-center w-1/3 border-black border-r border-l">{{formateur.email}}</div>
					<div class="flex-grow text-right w-1/3">
						<a class="bg-[#0B1141] text-white px-2 py-1 rounded-full" href="{{ path("app_formateur_signaler_stagiaire", {id: 1}) }}">Signaler</a>
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
{% endblock %}
