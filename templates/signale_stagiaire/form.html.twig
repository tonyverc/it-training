{% extends 'base.html.twig' %}

{% block title %}Hello FormateurSignalerStagiaireController!{% endblock %}

{% block body %}
<div class="h-[100%] bg-slate-100">
    <h2 class="w-[100%] text-2xl font-bold text-blue-950">Stagiaires</h2>
    <div class="flex flex-col items-center p-2">
    <div class="bg-[#0B1141] text-[#fffe] p-10 min-w-[50%] rounded-xl">
        <h3 class="w-[100%] text-xl text-center">signaler <span class="font-bold uppercase">{{nom_stagiaire}}</span> {{prenom_stagiaire}}</h3>

        {{form_start(form, {attr:{class:"flex flex-col gap-4 p-2"}})}}

        <div class="flex flex-col">
            <div>
                {{form_label(form.commentaire)}} :
            </div>
            {{form_widget(form.commentaire, {attr:{"class": "h-32 text-black"}})}}
        </div>
        {{form_widget(form.Signaler, {attr: {class: " w-max font-bold bg-[#38DEB9] text-[#000] px-2 py-1"}})}}
        {{form_end(form)}}
    </div>
</div>
    </div>
{% endblock %}