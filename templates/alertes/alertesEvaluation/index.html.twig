{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ encore_entry_link_tags('app') }}
	<link rel="stylesheet" href="{{ asset("styles/alertes.css") }}">
{% endblock %}



{% block body %}
	<style>

    </style>

	<div class="content-container">
		<div class="boutons-categorie">
                <a class="bouton-categorie active">Qualité</a>
			    <a class="bouton-categorie" href="{{path("app_alertes_stagiaires")}}" onclick="changerDeCategorie()">Décharge</a>
		</div>
		<ul class="alertes">

				{% for alerte in alertes %}
					<li class="alerte">
                    <div class="container-date-supprimer">
                        <p>Le <time datetime="">{{alerte.date|date('d/m/Y H:i')}}</time></p>
                        <div class="container-bouton-supprimer-alerte">
                        <button class="bouton-supprimer-alerte">
                            <div class="ligne a-gauche"></div>
                            <div class="ligne"></div>
                        </button>
                        </div>
                    </div>
						<h1 class="titre-alerte">{{alerte.titre}}</h1>
						<p><span>Formation:</span>
							{{alerte.formation.nom}}</p>
						<p class="description-alerte">{{alerte.description|raw}}</p>
                        <button class="btn-marquer-alerte">Marquer comme lu</button>
					</li>
				{% endfor %}
            
		</ul>
	</div>

    <script>

    const alertes = document.querySelectorAll('.alerte');

let maxHeight = 0;

// Step 1: find the tallest height
alertes.forEach(alerte => {
  const height = alerte.offsetHeight;
  if (height > maxHeight) {
    maxHeight = height;
  }
});

// Step 2: apply that height to all
alertes.forEach(alerte => {
  alerte.style.height = maxHeight + 'px';
});




    let switchCategorie;

    function changerDeCategorie() {
        if(!switchCategorie) {
            document.querySelector(".bouton-categorie.active").classList.remove("active");
            document.querySelectorAll(".bouton-categorie")[1].classList.add("active");
            console.log("s");
            switchCategorie = true;
        }
        else {
            document.querySelector(".bouton-categorie.active").classList.remove("active");
            document.querySelectorAll(".bouton-categorie")[0].classList.add("active");

            switchCategorie = false;
        }
    }
    </script>
{% endblock %}
