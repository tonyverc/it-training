{% extends 'base.html.twig' %}

{% block title %}Formulaire Evaluation{% endblock %}

{% block body %}
    <h2 class="text-center">Évaluation de la journée</h2>

{% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('warning') %}
    <div class="alert alert-warning">{{ message }}</div>
{% endfor %}

<div class="container">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            {{ form_start(form) }}
                {{ form_row(form.stagiaire) }}
                {{ form_row(form.formation) }}
                <div class="mb-3">
                    <label class="form-label">Satisfaction</label>
                    {{ form_widget(form.satisfaction) }}
                </div>
                {{ form_row(form.clarte) }}
                {{ form_row(form.difficultes) }}
                {{ form_row(form.suggestions) }}
                <button type="submit" class="btn btn-primary">{{ form_row(form.save) }}</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>

{% endblock %}
