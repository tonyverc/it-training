{% extends 'base.html.twig' %}

{% block title %}Évaluation Journalière{% endblock %}

{% block body %}
    <h1 class="text-center">Évaluation du jour</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">{{ message }}</div>
    {% endfor %}

    <div class="container">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                {{ form_start(form) }}

                {{ form_row(form.stagiaire) }}
                {{ form_row(form.formation) }}

                <div class="mb-3" data-controller="stars" data-stars-target="input">
                    <label class="form-label">Satisfaction</label>
                    <input type="hidden" id="evaluation_jour_satisfaction" name="evaluation_jour[satisfaction]" value="3">
                    {{ form_widget(form.satisfaction) }}
                </div>

                {{ form_row(form.clarte) }}
                {{ form_row(form.difficultes) }}
                {{ form_row(form.suggestions) }}
                {{ form_row(form.save) }}

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
